# Example settings for running Nudge with Docker Compose. Copy to .env (gitignored) next to compose.yaml and fill in
# what you need; everything is optional. compose.yaml passes only the variables it lists into the container.
# README "Configuration" has the full table, including the ones for local development and demo mode.

# --- Way in: Cloudflare Access ------------------------------------------------------------------------------------
# Hostname(s) Cloudflare Access fronts (comma-separated). Requests to them must carry a valid signed Access token.
NUDGE_ACCESS_HOSTS=
# Your Access team domain, <team>.cloudflareaccess.com.
NUDGE_ACCESS_TEAM_DOMAIN=
# The Access application's audience (AUD) tag.
NUDGE_ACCESS_AUD=
# Email(s) allowed in (comma-separated, exact match). Required when NUDGE_ACCESS_HOSTS is set: Nudge refuses to start
# without it rather than admit everyone Access lets through.
NUDGE_ALLOWED_USERS=

# --- Keys ---------------------------------------------------------------------------------------------------------
# YouTube Data API key. Or leave empty and paste it into Settings (it is then stored in the database).
YOUTUBE_API_KEY=
# OAuth client for posting replies from Nudge (else Settings, else ~/.nudge-google-client.json).
NUDGE_GOOGLE_CLIENT_ID=
NUDGE_GOOGLE_CLIENT_SECRET=

# --- Other --------------------------------------------------------------------------------------------------------
# Contact sent to push services with each notification (default mailto:nudge@example.invalid).
NUDGE_PUSH_SUBJECT=

# Not read by the container, but by deploy/backup.sh on the host: where the nightly off-box copy goes. Left
# unset, there is no off-box copy. Set it (in the cron environment: `NUDGE_BACKUP_DIR=/mnt/backup/nudge deploy/backup.sh`) to keep one.
# NUDGE_BACKUP_DIR=/mnt/backup/nudge

# --- Only outside Docker ------------------------------------------------------------------------------------------
# Not passed by compose.yaml (the image fixes them); for `npm start` / `npm run dev` they can be set in the shell.
# NUDGE_PORT=4517                 # API port
# NUDGE_HOST=127.0.0.1            # listen address; keep it loopback
# NUDGE_DB=data/nudge.db          # SQLite path (:memory: works)
# NUDGE_WEB_DIR=dist/web          # where the built web UI is served from
# GIT_SHA=                        # commit shown in Settings > About (the build works it out from git otherwise)
# ANTHROPIC_API_KEY=              # only for `npm run eval:classify`; the app's own key is entered in Settings
#
# Demo mode and the test suite: NUDGE_DEMO, NUDGE_DEMO_CLOCK, NUDGE_DEMO_GITHUB, NUDGE_DEMO_POST, NUDGE_DEMO_SUGGEST,
# NUDGE_DEMO_SUGGEST_CAP_AFTER, NUDGE_DEMO_COMMENTS, NUDGE_DEMO_BACKLOG, NUDGE_DEMO_HISTORY, NUDGE_DEMO_BUILD_ID,
# E2E_PORT_OFFSET and NUDGE_SHOTS. See README "Configuration" and CONTRIBUTING.md.
#
# Retired: NUDGE_ALLOWED_HOSTS (the Tailscale hostname) is ignored, with a warning at startup.
