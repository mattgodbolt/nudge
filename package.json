{
  "name": "nudge",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "Matt Godbolt <matt@godbolt.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattgodbolt/nudge.git"
  },
  "homepage": "https://github.com/mattgodbolt/nudge",
  "bugs": {
    "url": "https://github.com/mattgodbolt/nudge/issues"
  },
  "type": "module",
  "description": "Local keyboard-driven triage inbox for YouTube comments, GitHub and todos",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p server",
    "start": "npm run build && NODE_ENV=production node dist/server/server/index.js",
    "demo": "NUDGE_DEMO=1 NUDGE_DEMO_SUGGEST=1 NUDGE_DEMO_HISTORY=1 NUDGE_DB=data/demo.db npm run dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:deploy": "deploy/test-update.sh",
    "typecheck": "tsc -p server --noEmit && tsc -p tsconfig.test.json && tsc -p e2e/tsconfig.json && svelte-check --tsconfig web/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run check:links && npm test",
    "check:links": "node scripts/check-links.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "export:events": "tsx scripts/export-events.ts",
    "report:habits": "tsx scripts/report-habits.ts",
    "shots": "tsx scripts/screenshots.ts",
    "eval:classify": "tsx server/classify/eval.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^13.2.0",
    "dompurify": "^3.4.18",
    "fastify": "^5.12.8",
    "marked": "^18.2.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
